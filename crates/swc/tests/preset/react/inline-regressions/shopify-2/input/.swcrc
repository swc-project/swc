{
  "sourceMaps": false,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "decorators": false,
      "dts": false,
      "noEarlyErrors": false,
      "disallowAmbiguousJSXLike": false
    },
    "externalHelpers": false,
    "target": "es5",
    "loose": false,
    "keepClassNames": false,
    "preserveAllComments": false
  },
  "minify": false,
  "inputSourceMap": false,
  "inlineSourcesContent": false
}
