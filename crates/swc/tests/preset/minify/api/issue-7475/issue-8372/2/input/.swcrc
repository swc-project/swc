{
    "isModule": "unknown",
    "minify": true,
    "sourceMaps": true,
    "inlineSourcesContent": true,
    "jsc": {
        "parser": {
            "syntax": "ecmascript",
            "jsx": true,
            "decorators": true,
            "decoratorsBeforeExport": true,
            "importAttributes": true
        },
        "minify": {
            "compress": {
                "negate_iife": false,
                "sequences": 30
            },
            "mangle": {
                "safari10": true
            }
        },
        "output": {
            "preamble": ""
        }
    },
    "env": {
        "targets": {
            "chrome": "120"
        }
    }
}
