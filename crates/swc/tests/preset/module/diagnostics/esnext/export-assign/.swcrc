{
    "$schema": "http://json.schemastore.org/swcrc",
    "jsc": {
        "parser": {
            "syntax": "typescript"
        },
        "target": "es2020",
        "experimental": {
            "disableAllLints": false
        }
    },
    "module": {
        "type": "es6"
    },
    "isModule": "unknown"
}
