{
    "jsc": {
        "lints": {
            "no-param-reassign": [
                "error",
                {
                    "ignorePropertyModificationsForRegex": [
                        "^ignore"
                    ]
                }
            ]
        },
        "experimental": {
            "disableAllLints": false
        }
    },
    "isModule": "unknown"
}
