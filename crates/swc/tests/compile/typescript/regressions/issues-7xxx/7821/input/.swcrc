{
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true
        },
        "minify": {
            "compress": {
                "reduce_funcs": false,
                "reduce_vars": false
            },
            "mangle": {
                "toplevel": false
            }
        }
    },
    "module": {
        "type": "es6"
    }
}