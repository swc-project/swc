{
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true,
            "decorators": true
        },
        "preserveAllComments": true,
        "transform": null,
        "target": "es2017",
        "minify": {
            "compress": {
                "computed_props": false,
                "conditionals": false,
                "dead_code": false,
                "directives": false,
                "reduce_funcs": false,
                "reduce_vars": false,
                "switches": false
            }
        }
    }
}
