{
    "test": ".*.ts$",
    "jsc": {
        "loose": true,
        "target": "es2018",
        "parser": {
            "syntax": "typescript",
            "decorators": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
        }
    },
    "module": {
        "type": "commonjs",
        "strict": true,
        "strictMode": false
    }
}
