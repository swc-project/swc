{
  "env": {
    "include": [
      "transform-class-static-block",
      "transform-class-properties"
    ],
    "targets": {
      "chrome": "120"
    }
  },
  "isModule": "unknown",
  "jsc": {
    "assumptions": {
      "pureGetters": true
    },
    "externalHelpers": true,
    "parser": {
      "decorators": false,
      "syntax": "typescript",
      "tsx": false
    },
    "preserveAllComments": false,
    "transform": {
      "useDefineForClassFields": false
    }
  }
}
