{
  "isModule": true,
  "jsc": {
    "externalHelpers": true,
    "parser": {
      "jsx": true,
      "syntax": "ecmascript"
    },
    "preserveAllComments": true,
    "target": "esnext",
    "transform": {
      "react": {
        "pragma": "foo.bar",
        "runtime": "classic"
      }
    }
  }
}
