{
    "module": {
        "type": "amd"
    },
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true
        },
        "transform": {
            "react": {
                "pragma": "DCGView.createElement",
                "useBuiltins": true
            }
        }
    },
    "sourceMaps": "inline"
}
