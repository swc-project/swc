{
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true
        },
        "transform": {
            "react": {
                "runtime": "automatic"
            }
        },
        "minify": {
            "format": {
                "comments": false
            }
        }
    },
    "module": {
        "type": "es6"
    },
    "env": {
        "targets": "safari>15"
    }
}
