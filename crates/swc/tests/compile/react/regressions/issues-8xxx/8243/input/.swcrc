{
    "$schema": "https://json.schemastore.org/swcrc",
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true
        },
        "transform": {
            "react": {
                "runtime": "automatic"
            }
        },
        "baseUrl": "./",
        "target": "es2019",
        "keepClassNames": true,
        "minify": {
            "format": {
                "comments": false
            }
        }
    },
    "module": {
        "type": "es6"
    }
}
