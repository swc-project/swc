{
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true,
            "decorators": true
        },
        "target": "es2022",
        "transform": {
            "decoratorMetadata": true
        }
    },
    "module": {
        "type": "es6"
    },
    "isModule": "unknown"
}