{
    "$schema": "https://json.schemastore.org/swcrc",
    "jsc": {
        "parser": {
            "syntax": "typescript"
        },
        "transform": {
            "react": {
                "runtime": "automatic"
            }
        },
        "baseUrl": "./",
        "target": "es2019",
        "keepClassNames": true
    },
    "module": {
        "type": "es6"
    }
}