{
    "jsc": {
        "lints": {
            "quotes": [
                "error",
                {
                    "prefer": "double",
                    "avoidEscape": false,
                    "allowTemplateLiterals": false
                }
            ]
        },
        "experimental": {
            "disableAllLints": false
        }
    },
    "isModule": "unknown"
}
