{
    "jsc": {
        "parser": {
            "syntax": "ecmascript",
            "jsx": true,
        },
        "target": "es2022",
        "transform": {
            "react": {
                "development": true
            }
        },
        "minify": {
            "compress": {
                "reduce_funcs": false,
                "reduce_vars": false
            },
            "inlineSourcesContent": false
        }
    }
}