[
    {
        "jsc": {
            "externalHelpers": false,
            "parser": {
                "syntax": "ecmascript"
            }
        },
        "exclude": "\\.tsx?$"
    },
    {
        "jsc": {
            "externalHelpers": false,
            "parser": {
                "syntax": "typescript",
                "tsx": true
            }
        },
        "test": "\\.tsx$"
    },
    {
        "jsc": {
            "externalHelpers": false,
            "parser": {
                "syntax": "typescript"
            }
        },
        "test": "\\.ts$"
    }
]
