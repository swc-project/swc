{
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true
        },
        "transform": {
            "reactCompiler": {
                "eslintSuppressionRules": ["react-hooks/rules-of-hooks"],
                "environment": {
                    "validateHooksUsage": false
                }
            }
        }
    }
}
