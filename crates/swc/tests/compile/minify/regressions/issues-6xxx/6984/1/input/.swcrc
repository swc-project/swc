{
    "jsc": {
        "parser": {
            "syntax": "ecmascript",
            "jsx": true,
            "decorators": true,
            "decoratorsBeforeExport": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
        },
        "minify": {
            "format": {
                "comments": false
            }
        }
    },
    "isModule": "unknown",
    "env": {
        "mode": "usage",
        "coreJs": "3",
        "dynamicImport": true
    }
}
