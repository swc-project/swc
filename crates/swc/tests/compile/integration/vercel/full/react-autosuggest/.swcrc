{
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true
        },
        "transform": {
            "react": {
                "runtime": "automatic",
                "useBuiltins": true
            }
        },
        "minify": {
            "compress": {
                "toplevel": true
            },
            "toplevel": true
        }
    },
    "module": {
        "type": "commonjs"
    }
}
