{
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
        },
        "minify": {
            "compress": true,
            "mangle": true
        }
    },
    "minify": true,
    "sourceMaps": true
}
