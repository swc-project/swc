{
    "jsc": {
        "transform": {
            "noEmptyExport": true
        },
        "parser": {
            "syntax": "typescript",
            "decorators": false
        },
        "assumptions": {
            "pureGetters": true
        }
    },
    "env": {
        "targets": {
            "node": "18"
        },
        "include": ["transform-async-to-generator"]
    }
}
