{
    "jsc": {
        "transform": {
            "noEmptyExport": true,
            "useDefineForClassFields": false
        },
        "assumptions": {
            "pureGetters": true
        },
        "parser": {
            "syntax": "typescript",
            "decorators": true
        }
    },
    "env": {
        "targets": {
            "chrome": "120"
        },
        "include": [
            "transform-class-static-block",
            "transform-class-properties"
        ]
    }
}
