{
    "jsc": {
        "transform": {
            "noEmptyExport": true,
            "useDefineForClassFields": false,
            "legacyDecorator": true
        },
        "parser": {
            "syntax": "typescript",
            "decorators": true
        },
        "assumptions": {
            "pureGetters": true
        }
    },
    "env": {
        "targets": {
            "chrome": "120"
        },
        "include": []
    }
}
